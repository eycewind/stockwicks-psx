# Copy to .env.dev. Replace the development-only placeholders before use.
APP_ENV=development
APP_PORT=8101
PUBLIC_BASE_URL=http://127.0.0.1:8101
CLIENT_SLUG=local-dev
REDUCED_LOCAL_RUNTIME=true

SECRET_KEY=replace-with-generated-development-secret
MASTER_ADMIN_API_KEY=replace-with-generated-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_DB=stockwicks_dev
POSTGRES_USER=stockwicks_dev
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql://stockwicks_dev:replace-with-local-database-password@postgres:5432/stockwicks_dev
DB_CONNECT_TIMEOUT=5

DATA_DIR=/workspace/data
LOG_DIR=/workspace/logs
MODEL_DIR=/workspace/models

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

TRADING_ENABLED=false
PAPER_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
EMERGENCY_STOP=true

# Deliberately blank: the C2 runtime must not use broker credentials.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
STOCK_DATA_API_TOKEN=
API_TOKEN=
FINNHUB_API_KEY=
SENDGRID_API_KEY=

# C3 read-only PSX daily market data. Use a host path visible to Docker/WSL.
# Linux example: /absolute/path/to/psx-stock-watcher/data/psx_watcher.db
PSX_DB_HOST_PATH=/absolute/path/to/psx-stock-watcher/data/psx_watcher.db
MARKET_DATA_PROVIDER=psx_sqlite
MARKET_DATA_BASE_URL=
PSX_PRICE_MODE=adjusted
